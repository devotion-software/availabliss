<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of the app's goes to a cloud backup or a new phone: the session can't move (its key stays
     in this phone's Keystore), and plans, groups and widget data are fetched again after signing in. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
