{
	"name": "availabliss-web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"bun": ">=1.3"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''; git config core.hooksPath .githooks 2>/dev/null || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "bun test src",
		"test:integration": "bun test tests/integration",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"devDependencies": {
		"@revenuecat/purchases-js": "^1.73.2",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/bun": "~1.3.14",
		"@types/nodemailer": "^8.0.2",
		"dotenv": "^18.0.7",
		"drizzle-kit": "^0.31.11",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^1.3.0",
		"@better-auth/passkey": "1.7.14",
		"better-auth": "1.7.14",
		"drizzle-orm": "^0.45.4",
		"ioredis": "^5.10.1",
		"mysql2": "^3.24.5",
		"nanoid": "^6.0.2",
		"nodemailer": "^10.1.0",
		"zod": "^4.6.7"
	},
	"overrides": {
		"@better-auth/core": "1.7.14"
	}
}
