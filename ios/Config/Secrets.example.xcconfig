// ASSOCIATED_DOMAIN_HOST = your-tunnel.example.com

GOOGLE_IOS_CLIENT_ID = 1234567890-abcdefg.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.1234567890-abcdefg
