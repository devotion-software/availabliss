{
	"name": "availabliss-web",
	"private": true,
	"version": "0.1.1",
	"type": "module",
	"engines": {
		"bun": ">=1.3"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''; git config core.hooksPath .githooks 2>/dev/null || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "bun test src",
		"test:integration": "bun test tests/integration",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"test:e2e": "playwright test",
		"openapi": "bun scripts/openapi.ts",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.64.1",
		"@revenuecat/purchases-js": "^1.75.0",
		"@sveltejs/adapter-node": "^6.0.4",
		"@sveltejs/kit": "^3.3.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/bun": "~1.3.14",
		"@types/nodemailer": "^8.0.2",
		"dotenv": "^18.0.10",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"ts-json-schema-generator": "^2.9.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^1.10.0",
		"@better-auth/passkey": "1.7.25",
		"aws4fetch": "^1.0.20",
		"better-auth": "1.7.25",
		"drizzle-orm": "^0.45.4",
		"ioredis": "^5.11.1",
		"mysql2": "^3.24.6",
		"nanoid": "^6.0.2",
		"nodemailer": "^10.6.0",
		"sharp": "^0.35.5",
		"zod": "^4.6.7"
	},
	"overrides": {
		"@better-auth/core": "1.7.25"
	}
}
