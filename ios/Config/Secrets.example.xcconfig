// Copy to Config/Secrets.xcconfig (git-ignored) and fill in.
// Anything set here overrides Base.xcconfig.

DEVELOPMENT_TEAM = ABCDE12345

// Local dev server (make dev) reachable from the simulator:
// API_BASE_URL = http:/$()/localhost:5190
// ASSOCIATED_DOMAIN_HOST = your-tunnel.example.com

GOOGLE_IOS_CLIENT_ID = 1234567890-abcdefg.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.1234567890-abcdefg

// Sentry: turn it on for this machine's builds, and upload dSYMs when archiving.
// SENTRY_DSN = https:/$()/<key>@o123.ingest.sentry.io/456
// SENTRY_AUTH_TOKEN = sntrys_...
// SENTRY_ORG = your-org
// SENTRY_PROJECT = availabliss-ios
