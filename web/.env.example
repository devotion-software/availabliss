# ─── Database (MariaDB via docker-compose) ───────────────────────────────
DB_PORT=3312
DATABASE_URL=mysql://availabliss:availablisspass@localhost:3312/availabliss

# ─── Redis (docker-compose) ──────────────────────────────────────────────
# Live updates, native sign-in codes, rate limits and background-job locks.
# Required when running more than one instance; unset falls back to in-memory.
REDIS_URL=redis://localhost:6382
# Rate limiting is on in production and off in dev. Set on/off to override.
RATE_LIMIT=

# ─── Auth ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-dev-secret-change-me-dev-secret=
BETTER_AUTH_URL=http://localhost:5190
# Other origins allowed to call the auth endpoints. The Android emulator reaches the
# dev server as http://10.0.2.2:5190. Leave empty in production.
TRUSTED_ORIGINS=http://10.0.2.2:5190
# Encrypts calendar credentials at rest. Falls back to BETTER_AUTH_SECRET.
# Set it in production and never change it.
SECRETS_KEY=

# Google: sign-in and Google Calendar. Comma-separated client ids, web client first,
# then the iOS and Android client ids (accepted for native ID-token sign-in).
# Redirect URIs: http://localhost:5190/api/auth/callback/google
#                http://localhost:5190/api/v1/calendars/oauth/google/callback
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=

# Apple: Sign in with Apple. APPLE_CLIENT_ID is the Services ID for the web flow,
# APPLE_CLIENT_SECRET the signed client-secret JWT.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
IOS_BUNDLE_ID=dev.joeherbert.availabliss

# Microsoft / Outlook calendar (Entra app, delegated Calendars.Read).
# Redirect URI: http://localhost:5190/api/v1/calendars/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Android app links + passkeys (assetlinks.json)
ANDROID_PACKAGE=dev.joeherbert.availabliss
ANDROID_SHA256_FINGERPRINTS=

# ─── Push notifications ──────────────────────────────────────────────────
APNS_KEY_ID=
# Contents of the .p8 key (use \n for newlines)
APNS_KEY=
APNS_PRODUCTION=false
# Base64-encoded Firebase service-account JSON
FCM_SERVICE_ACCOUNT=

# ─── Pro (RevenueCat) ───────────────────────────────────────────────────
# See docs/BILLING.md. Leave empty to run without purchases (everyone is free;
# `make set-plan` grants Pro by hand).
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_IOS_KEY=
REVENUECAT_ANDROID_KEY=
REVENUECAT_WEB_KEY=
REVENUECAT_ENTITLEMENT=pro

# ─── Email ───────────────────────────────────────────────────────────────
# Delivery order: RESEND_API_KEY (prod) → SMTP (dev/Mailpit) → console.
SMTP_HOST=localhost
SMTP_PORT=1027
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Availabliss <no-reply@availabliss.local>
RESEND_API_KEY=
