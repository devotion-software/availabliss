	<array>
		<string>BricolageGrotesque-VariableFont_opsz,wdth,wght.ttf</string>
		<string>InstrumentSans-VariableFont_wdth,wght.ttf</string>
		<string>InstrumentSans-Italic-VariableFont_wdth,wght.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
